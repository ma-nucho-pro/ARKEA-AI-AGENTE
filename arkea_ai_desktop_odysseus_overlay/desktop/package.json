{
  "name": "arkea-ai-omniagent",
  "version": "0.1.0",
  "description": "ARKEA AI OmniAgent: agentes, IA local y gateway multi-IA",
  "main": "main.js",
  "author": "Arkeai AI Roberto Manuel Jara Peche",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dist:portable": "electron-builder --win portable --x64",
    "dist:nsis": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "26.15.3"
  },
  "overrides": {
    "@electron/asar": "4.2.1",
    "@electron/universal": "3.0.6",
    "brace-expansion": "5.0.8",
    "dir-compare": "5.0.0",
    "ejs": "6.0.1",
    "fast-uri": "4.1.1",
    "filelist": "2.0.2",
    "glob": "13.0.6",
    "jake": "12.10.1",
    "minimatch": "10.2.6",
    "rimraf": "6.1.3",
    "tar": "7.5.22"
  },
  "build": {
    "appId": "com.arkea.ai.omniagent",
    "productName": "ARKEA AI OmniAgent",
    "asar": true,
    "files": [
      "main.js",
      "request_auth.js",
      "preload.js",
      "package.json",
      "assets/**/*"
    ],
    "extraResources": [
      { "from": "backend-dist", "to": "backend-dist" },
      { "from": "ollama", "to": "ollama" },
      { "from": "legal", "to": "legal" }
    ],
    "directories": { "output": "dist" },
    "win": {
      "icon": "assets/icon.ico",
      "artifactName": "0_1-COMIENZA-POR-AQUI-ARKEA-AI-OmniAgent-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "0_1-COMIENZA-POR-AQUI-ARKEA-AI-OmniAgent-PORTABLE-${version}.${ext}"
    },
    "nsis": {
      "artifactName": "0_1-COMIENZA-POR-AQUI-ARKEA-AI-OmniAgent-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ARKEA AI OmniAgent",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico"
    }
  }
}
